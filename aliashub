# ============================================================================
#  p3 — операции: вход, записи, основни мутации, backup, fzf
# ============================================================================
ALIASHUB_INTERACTIVE="${ALIASHUB_INTERACTIVE:-0}"
_IN=""
_US=$'\x1f'   # разделител за полета в записите (никога не се среща в команди)

# ------------------------------ вход ----------------------------------------
ask_input() { # ask_input <подканващ текст> [стойност по подразбиране] -> $_IN
    local _p="$1" _def="${2:-}"
    _IN=""
    if [ -n "$_def" ] && [ "${BASH_VERSINFO[0]:-0}" -ge 4 ]; then
        read -e -r -i "$_def" -p "$(printf '%b%s%b ' "$C_INFO" "$_p" "$C_RESET")" _IN || return 1
    else
        printf "%b%s%b " "$C_INFO" "$_p" "$C_RESET"
        [ -n "$_def" ] && printf "%b[%s]%b " "$C_DIM" "$_def" "$C_RESET"
        read -r _IN || return 1
        [ -z "$_IN" ] && _IN="$_def"
    fi
    return 0
}

# ------------------------------ записи ---------------------------------------
# alias_entries чете файла и извежда: име<US>стойност<US>тагове<US>категория
# (мета-коментарът '# @aliashub ...' точно над алиаса се прикрепя към него)
alias_entries() {
    local _line _meta="" _name _val _p _tags _cat
    [ -f "$ALIASES_FILE" ] || return 0
    while IFS= read -r _line; do
        case "$_line" in
            "$META_TAG"*) _meta="${_line#"$META_TAG"}"; continue ;;
            "alias "*) ;;
            *) continue ;;
        esac
        _tags=""; _cat=""
        for _p in $_meta; do
            case "$_p" in
                tags=*)     _tags="${_p#tags=}" ;;
                category=*) _cat="${_p#category=}" ;;
            esac
        done
        _name="${_line#alias }"; _val="${_name#*=}"; _name="${_name%%=*}"
        printf '%s%s%s%s%s%s%s\n' "$_name" "$_US" "$_val" "$_US" "$_tags" "$_US" "$_cat"
        _meta=""
    done < "$ALIASES_FILE"
}

print_entry_row() { # <име> <стойност> <тагове> <категория>
    local _name="$1" _val="$2" _tags="$3" _cat="$4"
    _val="$(unquote "$_val")"
    local _meta=""
    [ -n "$_cat" ] && _meta="$_cat"
    if [ -n "$_tags" ]; then
        [ -n "$_meta" ] && _meta="$_meta · "
        _meta="$_meta$_tags"
    fi
    local _cw=45
    [ -n "$_meta" ] && _cw=28
    if [ "${#_val}" -gt "$_cw" ]; then _val="${_val:0:$((_cw - 3))}..."; fi
    printf "  %b%s%b %b→%b %b%s%b" \
        "$C_KEY" "$(pad_to "$_name" 18)" "$C_RESET" "$C_BORDER" "$C_RESET" "$C_VAL" "$_val" "$C_RESET"
    if [ -n "$_meta" ]; then
        printf " %b· %s%b" "$C_INFO" "$_meta" "$C_RESET"
    fi
    printf '\n'
}

render_entries_stdin() { # чете име<US>стойност<US>тагове<US>категория от stdin
    local _line
    printf "%b%s   %s%b\n" "$C_BORDER$C_DIM" \
        "$(pad_to "$(T list.col_name)" 20)" "$(T list.col_cmd)" "$C_RESET"
    dim "$(repeat_char "$BOX_H" "$HEADER_WIDTH")"
    while IFS= read -r _line; do
        [ -n "$_line" ] || continue
        local _rest _name _val _tg _ct
        _name="${_line%%"$_US"*}"
        _rest="${_line#*"$_US"}"
        _val="${_rest%%"$_US"*}"
        _rest="${_rest#*"$_US"}"
        _tg="${_rest%%"$_US"*}"
        _ct="${_rest#*"$_US"}"
        print_entry_row "$_name" "$_val" "$_tg" "$_ct"
    done
}

# ------------------------------ показване -----------------------------------
show_alias() { # show_alias <име>
    local _line _name _val _tg _ct _meta
    _line="$(awk_get_line "$1")"
    [ -n "$_line" ] || { fail "$(T err.not_found "$1")"; return 1; }
    _name="${_line#alias }"; _val="${_name#*=}"; _name="${_name%%=*}"
    printf "%b%s%b = %b%s%b\n" "$C_KEY$C_BOLD" "$_name" "$C_RESET" "$C_VAL" "$(unquote "$_val")" "$C_RESET"
    dim "  $_line"
    _tg="$(meta_get_tags "$1")"
    _ct="$(meta_get_cat "$1")"
    _meta=""
    [ -n "$_ct" ] && _meta="$_ct"
    if [ -n "$_tg" ]; then
        [ -n "$_meta" ] && _meta="$_meta · "
        _meta="$_meta$_tg"
    fi
    [ -n "$_meta" ] && info "  · $_meta"
    return 0
}

# ------------------------------ ядро: мутации -------------------------------
# Връщат 0 при успех; съобщението за грешка вече е изведено.
# В интерактивен режим (ALIASHUB_INTERACTIVE=1) питат за потвърждение.

core_add() { # <име> <команда> [тагове] [категория]
    local _name="$1" _cmd="$2" _tags="${3:-}" _cat="${4:-}" _dupe _meta
    is_valid_name "$_name" || { fail "$(T err.bad_name "$_name")"; return 1; }
    [ -n "$_cmd" ] || { fail "$(T err.empty_cmd)"; return 1; }
    case "$_cat" in *[[:space:],]*) fail "$(T cat.bad "$_cat")"; return 1 ;; esac
    case "$_tags" in *[[:space:]]*) fail "$(T tag.bad "$_tags")"; return 1 ;; esac
    _meta="$(meta_format "$_tags" "$_cat")"
    ensure_file
    if [ -n "$(awk_get_line "$_name")" ]; then
        fail "$(T err.exists "$_name")"; return 1
    fi
    if name_conflict "$_name"; then
        if [ "$ALIASHUB_INTERACTIVE" = "1" ]; then
            printf '\n'
            confirm err.conflict "$_name" || { info "$(T gen.cancelled)"; return 1; }
        else
            warn "$(T err.conflict_short "$_name")"
        fi
    fi
    _dupe="$(find_same_cmd "$_cmd")"
    if [ -n "$_dupe" ] && [ "$_dupe" != "$_name" ]; then
        info "$(T add.same_cmd "$_dupe")"
    fi
    make_backup >/dev/null || true
    {
        [ -n "$_meta" ] && printf '%s%s\n' "$META_TAG" "$_meta"
        printf 'alias %s=%s\n' "$_name" "$(sq "$_cmd")"
    } >> "$ALIASES_FILE" || { fail "$(T err.write_fail "$ALIASES_FILE")"; return 1; }
    return 0
}

core_remove() { # <име>
    local _name="$1"
    ensure_file
    if [ -z "$(awk_get_line "$_name")" ]; then
        fail "$(T err.not_found "$_name")"; return 1
    fi
    if [ "$ALIASHUB_INTERACTIVE" = "1" ]; then
        confirm rm.confirm "$_name" || { info "$(T gen.cancelled)"; return 1; }
    fi
    make_backup >/dev/null || true
    awk_remove_alias "$_name" || { fail "$(T err.write_fail "$ALIASES_FILE")"; return 1; }
    return 0
}

core_setcmd() { # <име> <нова команда>
    local _name="$1" _cmd="$2" _old _new
    ensure_file
    [ -n "$_cmd" ] || { fail "$(T err.empty_cmd)"; return 1; }
    _old="$(awk_get_line "$_name")"
    [ -n "$_old" ] || { fail "$(T err.not_found "$_name")"; return 1; }
    _new="$(printf 'alias %s=%s' "$_name" "$(sq "$_cmd")")"
    [ "$_old" = "$_new" ] && return 0
    make_backup >/dev/null || true
    awk_replace_line "$_old" "$_new" || { fail "$(T err.write_fail "$ALIASES_FILE")"; return 1; }
    return 0
}

core_rename() { # <старо_име> <ново_име> — метаредът остава прикрепен над реда
    local _old="$1" _new="$2"
    ensure_file
    [ -n "$(awk_get_line "$_old")" ] || { fail "$(T err.not_found "$_old")"; return 1; }
    is_valid_name "$_new" || { fail "$(T err.bad_name "$_new")"; return 1; }
    if [ -n "$(awk_get_line "$_new")" ]; then
        fail "$(T err.exists "$_new")"; return 1
    fi
    make_backup >/dev/null || true
    awk_replace_prefix "$_old" "$_new" || { fail "$(T err.write_fail "$ALIASES_FILE")"; return 1; }
    return 0
}

# ------------------------------ CLI команди ---------------------------------
cmd_add() { # add ИМЕ КОМАНДА... [--tags a,b] [--category c]
    local _tags="" _cat="" _pos=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --tags)       [ -n "${2:-}" ] || { fail "$(T err.missing_args --tags)"; return 2; }; _tags="$2"; shift ;;
            --tags=*)     _tags="${1#*=}" ;;
            --category)   [ -n "${2:-}" ] || { fail "$(T err.missing_args --category)"; return 2; }; _cat="$2"; shift ;;
            --category=*) _cat="${1#*=}" ;;
            --cat)        [ -n "${2:-}" ] || { fail "$(T err.missing_args --cat)"; return 2; }; _cat="$2"; shift ;;
            --cat=*)      _cat="${1#*=}" ;;
            *)            _pos+=("$1") ;;
        esac
        shift
    done
    [ "${#_pos[@]}" -ge 2 ] || { fail "$(T err.missing_args add)"; return 2; }
    local _name="${_pos[0]}"
    local _cmd="${_pos[*]:1}"
    if core_add "$_name" "$_cmd" "$_tags" "$_cat"; then
        ok "$(T add.ok "$_name")"
        dim "$(T gen.reload "$ALIASES_FILE")"
    else
        return 1
    fi
}

cmd_rm() {
    [ "$#" -ge 1 ] || { fail "$(T err.missing_args rm)"; return 2; }
    if core_remove "$1"; then
        ok "$(T rm.ok "$1")"
        dim "$(T gen.reload "$ALIASES_FILE")"
    else
        return 1
    fi
}

cmd_rename() {
    [ "$#" -ge 2 ] || { fail "$(T err.missing_args rename)"; return 2; }
    if core_rename "$1" "$2"; then
        ok "$(T ed.ok_name "$1" "$2")"
        dim "$(T gen.reload "$ALIASES_FILE")"
    else
        return 1
    fi
}

cmd_setcmd() {
    [ "$#" -ge 2 ] || { fail "$(T err.missing_args setcmd)"; return 2; }
    local _name="$1"; shift
    local _cmd="$*"
    if core_setcmd "$_name" "$_cmd"; then
        ok "$(T ed.ok_cmd "$_name")"
        dim "$(T gen.reload "$ALIASES_FILE")"
    else
        return 1
    fi
}

cmd_show() {
    [ "$#" -ge 1 ] || { fail "$(T err.missing_args show)"; return 2; }
    show_alias "$1"
}

cmd_edit_file() {
    ensure_file
    pick_editor
    info "$(T fe.open "$ALIASES_FILE" "$EDITOR_CMD")"
    "$EDITOR_CMD" "$ALIASES_FILE"
    printf '\n'
    cmd_check
}

# ------------------------------ backup --------------------------------------
cmd_backup() {
    ensure_file
    local _f
    _f="$(make_backup)" || { fail "$(T err.write_fail "$BACKUP_DIR")"; return 1; }
    [ -n "$_f" ] && ok "$(T bk.ok "$_f")"
    return 0
}

cmd_backups() {
    local _i=0 _f _sz
    while IFS= read -r _f; do
        [ -n "$_f" ] || continue
        if [ "$_i" -eq 0 ]; then
            printf "%b%s%b\n" "$C_INFO$C_BOLD" "$(T bk.header)" "$C_RESET"
        fi
        _i=$((_i + 1))
        _sz="$(wc -c < "$_f" 2>/dev/null | tr -d ' ' || true)"
        printf "  %b%2d)%b %s %b(%s B)%b\n" "$C_KEY" "$_i" "$C_RESET" "$_f" "$C_DIM" "${_sz:-?}" "$C_RESET"
    done < <(list_backups)
    if [ "$_i" -eq 0 ]; then
        info "$(T err.no_backups)"
        return 1
    fi
    return 0
}

cmd_restore() {
    local _target="${1:-}" _i=0 _f
    local _arr=()
    while IFS= read -r _f; do
        [ -n "$_f" ] || continue
        _i=$((_i + 1)); _arr[$_i]="$_f"
    done < <(list_backups)
    if [ "$_i" -eq 0 ]; then
        info "$(T err.no_backups)"; return 1
    fi
    if [ -z "$_target" ] || [ "$_target" = "last" ]; then
        _target="${_arr[1]}"
    elif [ ! -f "$_target" ]; then
        case "$_target" in
            ''|*[!0-9]*) fail "$(T err.not_found "$_target")"; return 1 ;;
            *)
                if [ "$_target" -ge 1 ] && [ "$_target" -le "$_i" ]; then
                    _target="${_arr[$_target]}"
                else
                    fail "$(T err.not_found "$_target")"; return 1
                fi
                ;;
        esac
    fi
    if [ "$ALIASHUB_INTERACTIVE" = "1" ]; then
        confirm bk.confirm "$_target" || { info "$(T gen.cancelled)"; return 1; }
    fi
    make_backup >/dev/null || true
    cp -p "$_target" "$ALIASES_FILE" || { fail "$(T err.write_fail "$ALIASES_FILE")"; return 1; }
    ok "$(T bk.ok_restore "$_target")"
    return 0
}

# ------------------------------ fzf -----------------------------------------
fzf_pick() { # чете 'alias x=...' от stdin, връща избора
    fzf --height=45% --border --prompt='🔍 ' \
        --color='fg:#d0d0d0,bg:#1e1e1e,hl:#5fd7ff' \
        --color='fg+:#ffffff,bg+:#2e2e2e,hl+:#ffaf00' \
        --color='info:#af87ff,prompt:#5fd7ff,pointer:#ff87d7' \
        --color='marker:#87ff00,spinner:#ff87d7,header:#87afaf'
}

fzf_missing_screen() {
    fail "$(T err.fzf_missing)"
    local _pm
    for _pm in dnf apt pacman zypper brew; do
        if command -v "$_pm" >/dev/null 2>&1; then break; fi
        _pm=""
    done
    case "${_pm:-dnf}" in
        dnf)    dim "$(T err.fzf_hint 'sudo dnf install fzf')" ;;
        apt)    dim "$(T err.fzf_hint 'sudo apt install fzf')" ;;
        pacman) dim "$(T err.fzf_hint 'sudo pacman -S fzf')" ;;
        zypper) dim "$(T err.fzf_hint 'sudo zypper install fzf')" ;;
        brew)   dim "$(T err.fzf_hint 'brew install fzf')" ;;
    esac
}
