main() {
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --no-color) USE_COLOR=0; set_color_vars ;;
            --lang)
                [ -n "${2:-}" ] || { fail "$(T err.missing_args --lang)"; exit 2; }
                LANG_MODE="$(lower "$2")"; shift
                ;;
            --lang=*) LANG_MODE="$(lower "${1#*=}")" ;;
            --file)
                [ -n "${2:-}" ] || { fail "$(T err.missing_args --file)"; exit 2; }
                ALIASES_FILE="$2"; shift
                ;;
            --file=*) ALIASES_FILE="${1#*=}" ;;
            -h|--help) usage; exit 0 ;;
            -V|--version) version; exit 0 ;;
            --) shift; break ;;
            -*) fail "$(T err.unknown_cmd "$1")"; exit 2 ;;
            *) break ;;
        esac
        shift
    done
    case "$LANG_MODE" in bg|en) ;; *) LANG_MODE="bg" ;; esac

    local _cmd="${1:-menu}"
    if [ "$#" -gt 0 ]; then shift; fi

    case "$_cmd" in
        ""|menu|interactive) run_menu ;;
        list|ls)             cmd_list "$@" ;;
        add)                 cmd_add "$@" ;;
        rm|remove|del)       cmd_rm "$@" ;;
        rename|mv)           cmd_rename "$@" ;;
        setcmd)              cmd_setcmd "$@" ;;
        show)                cmd_show "$@" ;;
        search|find)         cmd_search "$@" ;;
        tag|tags)            cmd_tag "$@" ;;
        category|cat)        cmd_category "$@" ;;
        lang)                cmd_lang "$@" ;;
        edit)                cmd_edit_file ;;
        file)                printf '%s\n' "$ALIASES_FILE" ;;
        backup)              cmd_backup ;;
        backups)             cmd_backups ;;
        restore)             cmd_restore "$@" ;;
        check)               cmd_check ;;
        doctor)              cmd_doctor ;;
        init)                cmd_init ;;
        stats)               cmd_stats ;;
        help)                usage ;;
        version)             version ;;
        *)                   fail "$(T err.unknown_cmd "$_cmd")"; exit 2 ;;
    esac
}

on_int() {
    if [ "${ALIASHUB_INTERACTIVE:-0}" = "1" ]; then
        printf '\n%b%s%b\n\n' "$C_SUCCESS$C_BOLD" "$(T gb.bye)" "$C_RESET"
        exit 130
    fi
    printf '\n'
    exit 130
}

main "$@"
