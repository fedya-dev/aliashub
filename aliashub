#  p3b — мета (категории/тагове), list/search с филтри, lang, check, doctor,
#        init, stats
# ============================================================================

# ------------------------------ мета система ---------------------------------
normalize_tags() { # <a, b,,c> -> "a,b,c" (без дубликати, без празни)
    local _in="$1" _o="" _p _seen="" _oldIFS="$IFS"
    [ -n "$_in" ] || { printf ''; return 0; }
    IFS=","
    for _p in $_in; do
        _p="${_p#"${_p%%[![:space:]]*}"}"
        _p="${_p%"${_p##*[![:space:]]}"}"
        [ -n "$_p" ] || continue
        case ",$_seen," in *",$_p,"*) continue ;; esac
        _seen="$_seen,$_p"
        [ -n "$_o" ] && _o="$_o,"
        _o="$_o$_p"
    done
    IFS="$_oldIFS"
    printf '%s' "$_o"
}

meta_format() { # <тагове> <категория> -> "tags=… category=…" (може и празно)
    local _tags="$1" _cat="$2" _out=""
    _tags="$(normalize_tags "$_tags")"
    [ -n "$_tags" ] && _out="tags=$_tags"
    if [ -n "$_cat" ]; then
        [ -n "$_out" ] && _out="$_out "
        _out="${_out}category=$_cat"
    fi
    printf '%s' "$_out"
}

alias_lineno() { # <име> -> номер на реда в файла (или нищо)
    [ -f "$ALIASES_FILE" ] || return 0
    A_PREFIX="alias $1=" awk 'index($0, ENVIRON["A_PREFIX"]) == 1 { print NR; exit }' \
        "$ALIASES_FILE" 2>/dev/null
}

meta_content_of() { # <име> -> съдържанието на метареда над алиаса (без префикса)
    local _aln _prev
    _aln="$(alias_lineno "$1")"
    [ -n "$_aln" ] || return 0
    [ "$_aln" -gt 1 ] || return 0
    _prev="$(sed -n "$((_aln - 1))p" "$ALIASES_FILE" 2>/dev/null)"
    case "$_prev" in
        "$META_TAG"*) printf '%s' "${_prev#"$META_TAG"}" ;;
    esac
    return 0
}

meta_field() { # <съдържание> <tags|category> -> стойност
    local _p
    for _p in $1; do
        case "$_p" in
            "$2="*) printf '%s' "${_p#"$2="}"; return 0 ;;
        esac
    done
    return 0
}

meta_get_tags() { meta_field "$(meta_content_of "$1")" tags; }
meta_get_cat()  { meta_field "$(meta_content_of "$1")" category; }

_meta_write() { # <име> <съдържание-или-"" (изтриване)> — backup се прави от викащия
    local _name="$1" _content="$2" _aln _mln=0 _prev _tmp
    _aln="$(alias_lineno "$_name")"
    [ -n "$_aln" ] || return 1
    if [ "$_aln" -gt 1 ]; then
        _prev="$(sed -n "$((_aln - 1))p" "$ALIASES_FILE" 2>/dev/null)"
        case "$_prev" in
            "$META_TAG"*) _mln=$((_aln - 1)) ;;
        esac
    fi
    _tmp="$(mktemp)" || return 1
    A_MLN="$_mln" A_ALN="$_aln" A_CONTENT="$_content" A_TAG="$META_TAG" awk '
        NR == ENVIRON["A_MLN"] { next }
        NR == ENVIRON["A_ALN"] {
            if (ENVIRON["A_CONTENT"] != "") print ENVIRON["A_TAG"] ENVIRON["A_CONTENT"]
            print
            next
        }
        { print }
    ' "$ALIASES_FILE" > "$_tmp" || { rm -f "$_tmp"; return 1; }
    mv "$_tmp" "$ALIASES_FILE"
}

core_set_meta() { # <име> <тагове> <категория> — празни стойности изчистват
    local _name="$1" _tags="$2" _cat="$3" _meta
    [ -n "$(alias_lineno "$_name")" ] || { fail "$(T err.not_found "$_name")"; return 1; }
    case "$_cat" in
        *[[:space:],]*) fail "$(T cat.bad "$_cat")"; return 1 ;;
    esac
    case "$_tags" in
        *[[:space:]]*) fail "$(T tag.bad "$_tags")"; return 1 ;;
    esac
    _meta="$(meta_format "$_tags" "$_cat")"
    make_backup >/dev/null || true
    _meta_write "$_name" "$_meta" || { fail "$(T err.write_fail "$ALIASES_FILE")"; return 1; }
    return 0
}

# ------------------------------ list ----------------------------------------
cmd_list() { # list [--raw] [--tag T] [--category C] [-g]
    ensure_file
    local _raw=0 _tag="" _cat="" _grouped=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --raw)                _raw=1 ;;
            --tag)                [ -n "${2:-}" ] || { fail "$(T err.missing_args --tag)"; return 2; }; _tag="$2"; shift ;;
            --tag=*)              _tag="${1#*=}" ;;
            --category|--cat)     [ -n "${2:-}" ] || { fail "$(T err.missing_args --category)"; return 2; }; _cat="$2"; shift ;;
            --category=*|--cat=*) _cat="${1#*=}" ;;
            -g|--grouped)         _grouped=1 ;;
            *)                    fail "$(T err.unknown_cmd "$1")"; return 2 ;;
        esac
        shift
    done
    local _flt=""
    [ -n "$_tag" ] && _flt="$(T flt.tag "$_tag")"
    [ -n "$_cat" ] && _flt="$_flt$( [ -n "$_flt" ] && printf ' · ' )$(T flt.cat "$_cat")"

    local _tmp; _tmp="$(mktemp)" || return 1
    local _name _val _tg _ct _hit _t _oldIFS _cnt=0
    while IFS="$_US" read -r _name _val _tg _ct; do
        [ -n "$_name" ] || continue
        _hit=1
        if [ -n "$_tag" ]; then
            _hit=0
            _oldIFS="$IFS"; IFS=","
            for _t in $_tg; do
                [ "$(lower "$_t")" = "$(lower "$_tag")" ] && { _hit=1; break; }
            done
            IFS="$_oldIFS"
        fi
        if [ "$_hit" -eq 1 ] && [ -n "$_cat" ]; then
            [ "$(lower "$_ct")" = "$(lower "$_cat")" ] || _hit=0
        fi
        [ "$_hit" -eq 1 ] || continue
        printf '%s%s%s%s%s%s%s\n' "$_name" "$_US" "$_val" "$_US" "$_tg" "$_US" "$_ct" >> "$_tmp"
        _cnt=$((_cnt + 1))
    done < <(alias_entries)

    if [ "$_raw" -eq 1 ]; then
        while IFS="$_US" read -r _name _val _tg _ct; do
            [ -n "$_name" ] || continue
            printf 'alias %s=%s\n' "$_name" "$_val"
        done < "$_tmp"
        rm -f "$_tmp"
        return 0
    fi

    printf "%b📦 %s: %s · 📁 %s%b\n" "$C_INFO$C_BOLD" "$(T gen.total)" "$_cnt" "$ALIASES_FILE" "$C_RESET"
    if [ -n "$_flt" ]; then printf "%b%s%b\n" "$C_INFO" "$_flt" "$C_RESET"; fi
    if [ "$_cnt" -eq 0 ]; then
        if [ -n "$_flt" ]; then
            info "$(T flt.none)"
        else
            info "$(T gen.none)"
        fi
        rm -f "$_tmp"
        return 0
    fi

    if [ "$_grouped" -eq 1 ]; then
        # групиране по категория — в реда на появата; „без категория" най-отдолу
        local _cats="" _grp _k
        while IFS="$_US" read -r _name _val _tg _ct; do
            [ -n "$_name" ] || continue
            [ -n "$_ct" ] || continue
            case "$_cats" in *"$_ct"*) ;; *) _cats="$_cats$_ct"$'\n' ;; esac
        done < "$_tmp"
        while IFS= read -r _grp; do
            [ -n "$_grp" ] || continue
            _k="$(awk -F "$_US" -v c="$_grp" '$4 == c { n++ } END { print n + 0 }' "$_tmp")"
            [ "$_k" -gt 0 ] || continue
            printf '\n%b── %s (%s) ──%b\n' "$C_TITLE$C_BOLD" "$_grp" "$_k" "$C_RESET"
            awk -F "$_US" -v c="$_grp" '$4 == c' "$_tmp" | render_entries_stdin
        done <<< "$_cats"
        _k="$(awk -F "$_US" '$4 == "" { n++ } END { print n + 0 }' "$_tmp")"
        if [ "$_k" -gt 0 ]; then
            printf '\n%b── %s (%s) ──%b\n' "$C_TITLE$C_BOLD" "$(T grp.uncat)" "$_k" "$C_RESET"
            awk -F "$_US" '$4 == ""' "$_tmp" | render_entries_stdin
        fi
    else
        render_entries_stdin < "$_tmp"
    fi
    rm -f "$_tmp"
    return 0
}

# ------------------------------ search --------------------------------------
cmd_search() {
    ensure_file
    local _term="${1:-}" _sel _name _val
    if [ -z "$_term" ] && command -v fzf >/dev/null 2>&1; then
        _sel="$(alias_lines | sed 's/^alias //' | fzf --height=45% --border --prompt='🔍 ' \
            --color='fg:#d0d0d0,bg:#1e1e1e,hl:#5fd7ff' \
            --color='fg+:#ffffff,bg+:#2e2e2e,hl+:#ffaf00' \
            --color='info:#af87ff,prompt:#5fd7ff,pointer:#ff87d7' \
            --color='marker:#87ff00,spinner:#ff87d7,header:#87afaf' || true)"
        [ -n "$_sel" ] || return 0
        _sel="alias $_sel"
        _name="${_sel#alias }"; _val="${_name#*=}"; _name="${_name%%=*}"
        printf "%b%s%b = %b%s%b\n" "$C_KEY$C_BOLD" "$_name" "$C_RESET" "$C_VAL" "$(unquote "$_val")" "$C_RESET"
        return 0
    fi
    [ -n "$_term" ] || { fail "$(T err.missing_args search)"; return 2; }
    local _lt _found=0 _tmp
    _lt="$(lower "$_term")"
    _tmp="$(mktemp)" || return 1
    local _name _val _tg _ct _uv
    while IFS="$_US" read -r _name _val _tg _ct; do
        [ -n "$_name" ] || continue
        _uv="$(lower "$(unquote "$_val")")"
        # case с кавички около променливата = буквално търсене (без glob)
        case "$(lower "$_name")|$_uv|$(lower "$_tg")|$(lower "$_ct")" in
            *"$_lt"*)
                printf '%s%s%s%s%s%s%s\n' "$_name" "$_US" "$_val" "$_US" "$_tg" "$_US" "$_ct" >> "$_tmp"
                _found=$((_found + 1))
                ;;
        esac
    done < <(alias_entries)
    if [ "$_found" -eq 0 ]; then
        rm -f "$_tmp"
        info "$(T se.none "$_term")"
        return 1
    fi
    render_entries_stdin < "$_tmp"
    info "$(T se.found "$_found")"
    rm -f "$_tmp"
    return 0
}

# ------------------------------ tag / category -------------------------------
cmd_tag() { # tag ИМЕ [ТАГОВЕ] — без аргументи показва; празен низ изчиства
    [ "$#" -ge 1 ] || { fail "$(T err.missing_args tag)"; return 2; }
    local _name="$1"; shift
    if [ "$#" -eq 0 ]; then
        local _cur
        _cur="$(meta_get_tags "$_name")"
        if [ -n "$_cur" ]; then
            ok "$(T tag.current "$_name" "$_cur")"
        else
            info "$(T tag.none "$_name")"
        fi
        return 0
    fi
    local _tags="$*"
    local _cat _cur
    _cat="$(meta_get_cat "$_name")"
    if core_set_meta "$_name" "$_tags" "$_cat"; then
        _cur="$(meta_get_tags "$_name")"
        if [ -n "$_cur" ]; then
            ok "$(T tag.ok "$_name" "$_cur")"
        else
            ok "$(T tag.cleared)"
        fi
        dim "$(T gen.reload "$ALIASES_FILE")"
    else
        return 1
    fi
}

cmd_category() { # category ИМЕ [КАТЕГОРИЯ]
    [ "$#" -ge 1 ] || { fail "$(T err.missing_args category)"; return 2; }
    local _name="$1"; shift
    if [ "$#" -eq 0 ]; then
        local _cur
        _cur="$(meta_get_cat "$_name")"
        if [ -n "$_cur" ]; then
            ok "$(T cat.current "$_name" "$_cur")"
        else
            info "$(T cat.none "$_name")"
        fi
        return 0
    fi
    local _cat="$*"
    local _tg _cur
    _tg="$(meta_get_tags "$_name")"
    if core_set_meta "$_name" "$_tg" "$_cat"; then
        _cur="$(meta_get_cat "$_name")"
        if [ -n "$_cur" ]; then
            ok "$(T cat.ok "$_name" "$_cur")"
        else
            ok "$(T cat.cleared)"
        fi
        dim "$(T gen.reload "$ALIASES_FILE")"
    else
        return 1
    fi
}

# ------------------------------ език ----------------------------------------
cmd_lang() { # lang [bg|en] — без аргумент показва; с аргумент запазва трайно
    local _l="${1:-}"
    if [ -z "$_l" ]; then
        ok "$(T lg.current "$LANG_MODE")"
        dim "$(T lg.hint)"
        return 0
    fi
    _l="$(lower "$_l")"
    case "$_l" in
        bg|en) ;;
        *) fail "$(T lg.usage)"; return 2 ;;
    esac
    if mkdir -p "$CONFIG_DIR" 2>/dev/null; then
        local _tmp _old
        _tmp="$(mktemp)" || return 1
        _old=""
        [ -f "$CONFIG_FILE" ] && _old="$(grep -v '^lang=' "$CONFIG_FILE" 2>/dev/null || true)"
        {
            [ -n "$_old" ] && printf '%s\n' "$_old"
            printf 'lang=%s\n' "$_l"
        } > "$_tmp"
        if mv "$_tmp" "$CONFIG_FILE" 2>/dev/null; then
            LANG_MODE="$_l"
            ok "$(T lg.saved "$CONFIG_FILE")"
            return 0
        fi
        rm -f "$_tmp"
    fi
    LANG_MODE="$_l"
    warn "$(T lg.cfg_fail)"
    return 0
}

# ------------------------------ проверка на файла ----------------------------
# Философия: bash -n е върховният съдия за синтаксис; този проход прави само
# смислови проверки на алиас-редовете на най-високо ниво. Функциите, if/for
# блоковете, export-ите и всякаква кирилица в тях са НАПЪЛНО ВАЛИДНИ и НЕ се
# докладват (тук беше проблемът „148 фалшиви проблема" в v3).
CK_ISSUES=0
CK_TOTAL=0

_check_pass() { # $1 = quiet|verbose — пълни CK_ISSUES/CK_TOTAL
    local _mode="${1:-verbose}"
    local _line _ln=0 _name _val _depth=0 _o _c _p _ok
    CK_ISSUES=0
    CK_TOTAL=0
    [ -f "$ALIASES_FILE" ] || return 0
    # A) реален синтактичен анализ от bash
    local _bn
    _bn="$(bash -n "$ALIASES_FILE" 2>&1)" || {
        [ "$_mode" = "verbose" ] && warn "$(T ck.syntax "$_bn")"
        CK_ISSUES=$((CK_ISSUES + 1))
    }
    # B) ред по ред — смислови проверки
    local _dups=""
    while IFS= read -r _line; do
        _ln=$((_ln + 1))
        case "$_line" in ""|\#*) continue ;; esac
        case "$_line" in
            "$META_TAG"*)
                _ok=1
                for _p in ${_line#"$META_TAG"}; do
                    case "$_p" in
                        tags=*)     [ -n "${_p#tags=}" ] || _ok=0 ;;
                        category=*) [ -n "${_p#category=}" ] || _ok=0 ;;
                        *) _ok=0 ;;
                    esac
                done
                if [ "$_ok" -eq 0 ]; then
                    [ "$_mode" = "verbose" ] && warn "$(T ck.meta_bad "$_ln" "$_line")"
                    CK_ISSUES=$((CK_ISSUES + 1))
                fi
                continue
                ;;
            "alias "*) : ;;
            *)
                _o="${_line//[!{]/}"
                _c="${_line//[!}]/}"
                _depth=$(( _depth + ${#_o} - ${#_c} ))
                continue
                ;;
        esac
        if [ "$_depth" -gt 0 ]; then
            _o="${_line//[!{]/}"
            _c="${_line//[!}]/}"
            _depth=$(( _depth + ${#_o} - ${#_c} ))
            continue
        fi
        case "$_line" in
            *"="*) : ;;
            *)
                [ "$_mode" = "verbose" ] && warn "$(T ck.no_eq "$_ln" "$_line")"
                CK_ISSUES=$((CK_ISSUES + 1))
                continue
                ;;
        esac
        _name="${_line#alias }"; _name="${_name%%=*}"
        _val="${_line#*=}"
        is_valid_name "$_name" || {
            [ "$_mode" = "verbose" ] && warn "$(T ck.name_bad "$_ln" "$_name")"
            CK_ISSUES=$((CK_ISSUES + 1))
        }
        [ -n "$(unquote "$_val")" ] || {
            [ "$_mode" = "verbose" ] && warn "$(T ck.empty_cmd "$_ln")"
            CK_ISSUES=$((CK_ISSUES + 1))
        }
        case "$_val" in
            "'"*|'"'*) : ;;
            *[[:space:]]*)
                [ "$_mode" = "verbose" ] && warn "$(T ck.unquoted "$_ln" "$_line")"
                CK_ISSUES=$((CK_ISSUES + 1))
                ;;
        esac
        CK_TOTAL=$((CK_TOTAL + 1))
        _dups="$_dups$_name"$'\n'
    done < "$ALIASES_FILE"
    local _d
    for _d in $(printf '%s' "$_dups" | sort | uniq -d); do
        [ "$_mode" = "verbose" ] && warn "$(T ck.dup "$_d")"
        CK_ISSUES=$((CK_ISSUES + 1))
    done
    return 0
}

cmd_check() {
    ensure_file
    _check_pass verbose
    if [ "$CK_ISSUES" -eq 0 ]; then
        ok "$(T ck.ok "$CK_TOTAL")"
        local _others
        _others="$(grep -cv -e '^alias ' -e '^#' -e '^$' "$ALIASES_FILE" 2>/dev/null || true)"
        case "${_others:-0}" in
            [1-9]*) dim "  $(T ck.funcs)" ;;
        esac
        return 0
    fi
    fail "$(T ck.issues "$CK_ISSUES")"
    return 1
}

# ------------------------------ диагностика ---------------------------------
_dr_bad=0
dr_ok()  { printf "  %b%s %s%b\n" "$C_SUCCESS" "$(T dr.mark_ok)" "$1" "$C_RESET"; }
dr_bad() { printf "  %b%s %s%b\n" "$C_ERROR"   "$(T dr.mark_bad)" "$1" "$C_RESET"; _dr_bad=$((_dr_bad + 1)); }
dr_opt() { printf "  %b%s %s%b\n" "$C_DIM"     "~"                 "$1" "$C_RESET"; }

cmd_doctor() {
    local _n _rc
    _dr_bad=0
    printf "%b%s%b\n\n" "$C_PRIMARY$C_BOLD" "$(T t.doctor)" "$C_RESET"
    # 1. файл
    _n="$(count_aliases)"
    if [ -f "$ALIASES_FILE" ]; then
        dr_ok "$(T dr.file): $ALIASES_FILE ($_n)"
    else
        dr_bad "$(T dr.file): $ALIASES_FILE — $(T dr.file_missing)"
    fi
    # 2. синтаксис и смислови проверки (тихо; без фалшиви положителни)
    _check_pass quiet
    if [ "$CK_ISSUES" -eq 0 ]; then
        dr_ok "$(T dr.file_syntax)"
    else
        dr_bad "$(T dr.file_syntax) — $(T dr.ck_issues "$CK_ISSUES")"
    fi
    # 3. .bashrc
    if [ -f "$HOME/.bashrc" ] && grep -Fq "$ALIASES_FILE" "$HOME/.bashrc" 2>/dev/null; then
        dr_ok "$(T dr.rc_bash)"
    else
        dr_bad "$(T dr.rc_bash)"
    fi
    # 4. .zshrc — само ако zsh е наличен/използван
    if command -v zsh >/dev/null 2>&1 || [ -f "$HOME/.zshrc" ]; then
        if [ -f "$HOME/.zshrc" ] && grep -Fq "$ALIASES_FILE" "$HOME/.zshrc" 2>/dev/null; then
            dr_ok "$(T dr.rc_zsh)"
        else
            dr_bad "$(T dr.rc_zsh)"
        fi
    fi
    # 5. редактор
    pick_editor
    dr_ok "$(T dr.editor): $EDITOR_CMD"
    # 6. fzf (опционално)
    if command -v fzf >/dev/null 2>&1; then
        dr_ok "$(T dr.fzf)"
    else
        dr_opt "$(T dr.fzf) — $(T dr.not_set)"
    fi
    # 7. backup папка
    if ensure_backup_dir && touch "$BACKUP_DIR/.wtest" 2>/dev/null; then
        rm -f "$BACKUP_DIR/.wtest"
        dr_ok "$(T dr.backups): $BACKUP_DIR"
    else
        dr_bad "$(T dr.backups): $BACKUP_DIR"
    fi
    # 8. език
    dr_ok "$(T dr.lang): $LANG_MODE"
    printf '\n'
    if [ "$_dr_bad" -eq 0 ]; then
        ok "$(T dr.all_ok)"
        return 0
    fi
    warn "$(T dr.hint_init)"
    fail "$(T dr.issues "$_dr_bad")"
    return 1
}

# ------------------------------ init ----------------------------------------
cmd_init() {
    ensure_file
    local _rc _path _tmp
    printf "%b%s%b\n\n" "$C_PRIMARY$C_BOLD" "$(T t.init)" "$C_RESET"
    for _rc in .bashrc .zshrc; do
        _path="$HOME/$_rc"
        if [ "$_rc" = ".zshrc" ] && [ ! -f "$_path" ] && ! command -v zsh >/dev/null 2>&1; then
            dim "$(T in.skip_zsh)"
            continue
        fi
        if [ -f "$_path" ] && grep -Fq "# >>> aliasctl (" "$_path" 2>/dev/null; then
            # надгради стария aliasctl блок от v3.x (прави се ПРЕДИ проверката
            # за нов блок — иначе старият блок може да остане завинаги)
            _tmp="$(mktemp)"
            sed 's|# >>> aliasctl (|# >>> aliashub (|g; s|# <<< aliasctl <<<|# <<< aliashub <<<|g' \
                "$_path" > "$_tmp" && mv "$_tmp" "$_path" || { rm -f "$_tmp"; }
            ok "$(T in.upgraded "$_path")"
            continue
        fi
        if [ -f "$_path" ] && grep -Fq "# >>> aliashub (" "$_path" 2>/dev/null; then
            dim "$(T in.present "$_path")"
            continue
        fi
        if [ ! -f "$_path" ]; then
            : > "$_path"
            ok "$(T in.created "$_path")"
        fi
        { printf '\n# >>> aliashub (%s) >>>\n' "$ALIASHUB_SITE"
          printf '[ -f "%s" ] && source "%s"\n' "$ALIASES_FILE" "$ALIASES_FILE"
          printf '# <<< aliashub <<<\n'
        } >> "$_path"
        ok "$(T in.added "$_path")"
    done
    printf '\n%s\n' "$(T hp.autoload)"
}

# ------------------------------ статистика ----------------------------------
cmd_stats() {
    ensure_file
    local _n _sz _mt _lb
    _n="$(count_aliases)"
    _sz="$(wc -c < "$ALIASES_FILE" 2>/dev/null | tr -d ' ' || true)"
    _mt="$(date -r "$ALIASES_FILE" '+%Y-%m-%d %H:%M' 2>/dev/null || true)"
    _lb="$(list_backups | head -n 1 || true)"
    [ -n "$_lb" ] && _lb="$(basename "$_lb")"
    printf "%b%s%b\n\n" "$C_PRIMARY$C_BOLD" "$(T t.stats)" "$C_RESET"
    printf "  %b%s%b %s\n" "$C_KEY" "$(pad_to "$(T st.count)" 16)" "$C_RESET" "$_n"
    printf "  %b%s%b %s\n" "$C_KEY" "$(pad_to "$(T st.size)" 16)" "$C_RESET" "${_sz:-?} B"
    printf "  %b%s%b %s\n" "$C_KEY" "$(pad_to "$(T st.modified)" 16)" "$C_RESET" "${_mt:-?}"
    printf "  %b%s%b %s\n" "$C_KEY" "$(pad_to "$(T st.last_backup)" 16)" "$C_RESET" "${_lb:-$(T st.never)}"
    if [ "$_n" -gt 0 ]; then
        local _catline
        _catline="$(alias_entries | A_US="$_US" A_UNCAT="$(T grp.uncat)" awk '
            BEGIN { FS = ENVIRON["A_US"] }
            {
                c = ($4 == "" ? "UNCAT" : $4)
                n[c]++
                if ($3 != "") tg++
            }
            END {
                for (c in n) printf "%d\t%s\n", n[c], (c == "UNCAT" ? ENVIRON["A_UNCAT"] : c)
                if (tg != "") printf "0\t__TAGGED__%d\n", tg
            }' | sort -rn | A_TAGGED="$(T st.tagged)" awk '
            BEGIN { first = 1 }
            {
                if ($2 ~ /^__TAGGED__/) { tg = $2; sub(/^__TAGGED__/, "", tg); tagged = tg; next }
                if (first != 1) printf " · "
                printf "%s: %s", $2, $1
                first = 0
            }
            END {
                if (tagged != "") printf " · %s: %s", ENVIRON["A_TAGGED"], tagged
            }')"
        [ -n "$_catline" ] && printf "  %b%s%b %s\n" "$C_KEY" "$(pad_to "$(T st.by_cat)" 16)" "$C_RESET" "$_catline"
    fi
    return 0
}
