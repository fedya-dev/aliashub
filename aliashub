_meta_edit_flow() { # <име> <tags|category> — общ поток за тагове/категория
    local _name="$1" _kind="$2" _cur _msg_cur _msg_none _msg_ok _msg_clr _ask
    if [ "$_kind" = "tags" ]; then
        _cur="$(meta_get_tags "$_name")"
        _msg_cur="tag.current"; _msg_none="tag.none"
        _msg_ok="tag.ok"; _msg_clr="tag.cleared"
        _ask="ed.m7"
    else
        _cur="$(meta_get_cat "$_name")"
        _msg_cur="cat.current"; _msg_none="cat.none"
        _msg_ok="cat.ok"; _msg_clr="cat.cleared"
        _ask="ed.m6"
    fi
    if [ -n "$_cur" ]; then
        ok "$(T "$_msg_cur" "$_name" "$_cur")"
    else
        info "$(T "$_msg_none" "$_name")"
    fi
    ask_input "$(T "$_ask")" "$_cur" || return 1
    [ "$_IN" = "$_cur" ] && { info "$(T ed.m8)"; return 1; }
    if [ "$_kind" = "tags" ]; then
        core_set_meta "$_name" "$_IN" "$(meta_get_cat "$_name")" || return 1
        _cur="$(meta_get_tags "$_name")"
    else
        core_set_meta "$_name" "$(meta_get_tags "$_name")" "$_IN" || return 1
        _cur="$(meta_get_cat "$_name")"
    fi
    if [ -n "$_cur" ]; then
        ok "$(T "$_msg_ok" "$_name" "$_cur")"
    else
        ok "$(T "$_msg_clr")"
    fi
    reload_hint
    return 0
}

edit_alias_flow() { # <име> — подменю: команда, име, тагове, категория
    local _name="$1" _line _val _nn
    _line="$(awk_get_line "$_name")"
    if [ -z "$_line" ]; then
        fail "$(T err.not_found "$_name")"
        sleep 1
        return
    fi
    _val="$(unquote "${_line#*=}")"
    printf '\n'
    show_alias "$_name"
    printf '\n'
    printf "  %b[1]%b %s\n"   "$C_KEY$C_BOLD" "$C_RESET" "$(T ed.m1)"
    printf "  %b[2]%b %s\n"   "$C_KEY$C_BOLD" "$C_RESET" "$(T ed.m2)"
    printf "  %b[3]%b %s\n"   "$C_KEY$C_BOLD" "$C_RESET" "$(T ed.m3)"
    printf "  %b[4]%b %s\n"   "$C_KEY$C_BOLD" "$C_RESET" "$(T ed.m4)"
    printf "  %b[0]%b %s\n\n" "$C_KEY$C_BOLD" "$C_RESET" "$(T ed.m5)"
    ask_input "$(T menu.prompt)" || return
    case "$_IN" in
        1)
            ask_input "$(T ed.new_cmd)" "$_val" || return
            if core_setcmd "$_name" "$_IN"; then
                ok "$(T ed.ok_cmd "$_name")"
                reload_hint
            fi
            ;;
        2)
            ask_input "$(T ed.new_name)" || return
            _nn="$_IN"
            if core_rename "$_name" "$_nn"; then
                ok "$(T ed.ok_name "$_name" "$_nn")"
                reload_hint
            fi
            ;;
        3) _meta_edit_flow "$_name" tags ;;
        4) _meta_edit_flow "$_name" category ;;
        *) return ;;
    esac
    printf '\n'
    pause
}

pick_alias_numbered() { # -> име в $_IN (0 = отказ)
    local _names _i=0 _n
    _names="$(alias_names)"
    if [ -z "$_names" ]; then
