# --------------------- категории и тагове (екран) ----------------------------
count_cat() { # <категория> -> брой алиаси в нея
    local _n=0 _a _v _t _c
    while IFS="$_US" read -r _a _v _t _c; do
        [ "$_c" = "$1" ] && _n=$((_n + 1))
    done < <(alias_entries)
    printf '%s' "$_n"
}

count_tag() { # <таг> -> брой алиаси с този таг
    local _n=0 _a _v _tg _c _t _oldIFS="$IFS"
    while IFS="$_US" read -r _a _v _tg _c; do
        IFS=","
        for _t in $_tg; do
            [ "$_t" = "$1" ] && { _n=$((_n + 1)); break; }
        done
    done < <(alias_entries)
    IFS="$_oldIFS"
    printf '%s' "$_n"
}

_list_filtered_to_tmp() { # <tag|cat> <стойност> -> $_TMPF (или 1, ако празно)
    local _kind="$1" _what="$2" _name _val _tg _ct _hit _t _oldIFS
    _TMPF="$(mktemp)" || return 1
    while IFS="$_US" read -r _name _val _tg _ct; do
        [ -n "$_name" ] || continue
        _hit=0
        if [ "$_kind" = "tag" ]; then
            _oldIFS="$IFS"; IFS=","
            for _t in $_tg; do
                [ "$_t" = "$_what" ] && { _hit=1; break; }
            done
            IFS="$_oldIFS"
        else
            [ "$_ct" = "$_what" ] && _hit=1
        fi
        [ "$_hit" -eq 1 ] && printf '%s%s%s%s%s%s%s\n' \
            "$_name" "$_US" "$_val" "$_US" "$_tg" "$_US" "$_ct" >> "$_TMPF"
    done < <(alias_entries)
    if [ ! -s "$_TMPF" ]; then
        rm -f "$_TMPF"
        warn "$(T flt.none)"
        return 1
    fi
    return 0
}

_pick_alias_from_tmp() { # номериран избор от $_TMPF -> име в $_IN
    local _i=0 _line _name _tot _l
    while IFS= read -r _line; do
        [ -n "$_line" ] || continue
        _i=$((_i + 1))
        _name="${_line%%"$_US"*}"
        printf "  %b%2d)%b %s\n" "$C_KEY" "$_i" "$C_RESET" "$_name"
    done < "$_TMPF"
    printf '\n'
    ask_input "$(T ed.pick_num)" || { rm -f "$_TMPF"; return 1; }
    case "$_IN" in
        ''|*[!0-9]*) rm -f "$_TMPF"; fail "$(T ed.bad_pick)"; return 1 ;;
    esac
    _tot="$(wc -l < "$_TMPF" | tr -d ' ')"
    if [ "$_IN" -lt 1 ] || [ "$_IN" -gt "$_tot" ]; then
        rm -f "$_TMPF"
        fail "$(T ed.bad_pick)"
        return 1
    fi
    _l="$(sed -n "${_IN}p" "$_TMPF")"
    _IN="${_l%%"$_US"*}"
    rm -f "$_TMPF"
    [ -n "$_IN" ] || return 1
    return 0
}

_alias_actions() { # <име> — бързи действия върху избран алиас
    local _name="$1"
    print_header
    screen_title "$(T t.edit)"
    show_alias "$_name" || { printf '\n'; pause; return; }
    printf '\n'
    printf "  %b[1]%b %s\n"   "$C_KEY$C_BOLD" "$C_RESET" "$(T cs.act_edit)"
    printf "  %b[2]%b %s\n"   "$C_KEY$C_BOLD" "$C_RESET" "$(T cs.act_tag)"
    printf "  %b[3]%b %s\n"   "$C_KEY$C_BOLD" "$C_RESET" "$(T cs.act_cat)"
    printf "  %b[4]%b %s\n"   "$C_KEY$C_BOLD" "$C_RESET" "$(T cs.act_rm)"
    printf "  %b[0]%b %s\n\n" "$C_KEY$C_BOLD" "$C_RESET" "$(T cs.act_back)"
    ask_input "$(T menu.prompt)" || return
    case "$_IN" in
        1) edit_alias_flow "$_name" ;;
        2) _meta_edit_flow "$_name" tags; printf '\n'; pause ;;
        3) _meta_edit_flow "$_name" category; printf '\n'; pause ;;
        4)
            if core_remove "$_name"; then
                ok "$(T rm.ok "$_name")"
                reload_hint
            fi
            printf '\n'
            pause
            ;;
        *) return ;;
    esac
}

tags_screen() {
    print_header
    screen_title "$(T t.tags)"
    local _name _val _tg _ct _t _c _i
    local _cats="" _tags_all=""
    while IFS="$_US" read -r _name _val _tg _ct; do
        [ -n "$_name" ] || continue
        if [ -n "$_ct" ]; then
            case "$_cats" in *"$_ct"*) ;; *) _cats="$_cats$_ct"$'\n' ;; esac
        fi
        if [ -n "$_tg" ]; then
            local _oldIFS="$IFS"; IFS=","
            for _t in $_tg; do
                [ -n "$_t" ] || continue
                case "$_tags_all" in *"$_t"*) ;; *) _tags_all="$_tags_all$_t"$'\n' ;; esac
            done
            IFS="$_oldIFS"
        fi
    done < <(alias_entries)
    if [ -z "$_cats" ] && [ -z "$_tags_all" ]; then
        printf '\n'
        warn "$(T cs.empty)"
        printf '\n'
        pause
        return
    fi
    printf '\n'
    if [ -n "$_cats" ]; then
        _i=0
        while IFS= read -r _c; do
            [ -n "$_c" ] || continue
            _i=$((_i + 1))
            printf "  %b[%d]%b %s %b(%s)%b\n" "$C_KEY$C_BOLD" "$_i" "$C_RESET" "$_c" \
                "$C_DIM" "$(count_cat "$_c")" "$C_RESET"
        done <<< "$_cats"
    fi
    if [ -n "$_tags_all" ]; then
        printf '\n  %b%s:%b ' "$C_INFO$C_BOLD" "$(T cs.tags_line)" "$C_RESET"
        while IFS= read -r _t; do
            [ -n "$_t" ] || continue
            printf "%b%s%b %b(%s)%b   " "$C_KEY" "$_t" "$C_RESET" \
                "$C_DIM" "$(count_tag "$_t")" "$C_RESET"
        done <<< "$_tags_all"
        printf '\n'
    fi
    printf '\n'
    info "$(T cs.hint)"
    ask_input "$(T cs.pick_cat)" || return
    local _sel="$_IN"
    case "$_sel" in
        '') return ;;
        ''|*[!0-9]*)
            _list_filtered_to_tmp tag "$_sel" || { printf '\n'; pause; return; }
            ;;
        *)
            local _pick=""
            local _n=0
            while IFS= read -r _c; do
                [ -n "$_c" ] || continue
                _n=$((_n + 1))
                [ "$_n" = "$_sel" ] && { _pick="$_c"; break; }
            done <<< "$_cats"
            if [ -z "$_pick" ]; then
                fail "$(T ed.bad_pick)"
                sleep 1
                return
            fi
            _list_filtered_to_tmp cat "$_pick" || { printf '\n'; pause; return; }
            ;;
    esac
    printf '\n'
    screen_title "$(T t.list)"
    _pick_alias_from_tmp || { printf '\n'; pause; return; }
    _alias_actions "$_IN"
}

