    if [ "$_IN" -lt 1 ] || [ "$_IN" -gt "$_i" ]; then
        fail "$(T ed.bad_pick)"
        return 1
    fi
    _IN="$(printf '%s\n' "$_names" | sed -n "${_IN}p")"
    return 0
}

