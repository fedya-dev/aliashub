# ------------------------- Базови помощни функции ---------------------------
T() {
    # T <ключ> [аргументи...] — преведено съобщение без нов ред
    local _key="$1"; shift 2>/dev/null || true
    local _s=""
    # транслациите идват от msg_translate (p2_i18n.sh)
    msg_translate "$_key"
    _s="${T_BG:-}"; [ "$LANG_MODE" = "en" ] && _s="${T_EN:-}"
    unset T_BG T_EN
    if [ "$#" -gt 0 ]; then printf "$_s" "$@"; else printf '%b' "$_s"; fi
}

ok()    { printf "%b%s%b\n" "${C_SUCCESS}${C_BOLD}" "$*" "${C_RESET}"; }
fail()  { printf "%b%s%b\n" "${C_ERROR}" "$*" "${C_RESET}" >&2; }
warn()  { printf "%b%s%b\n" "${C_WARNING}" "$*" "${C_RESET}"; }
info()  { printf "%b%s%b\n" "${C_INFO}" "$*" "${C_RESET}"; }
dim()   { printf "%b%s%b\n" "${C_DIM}" "$*" "${C_RESET}"; }

repeat_char() { # repeat_char <символ> <брой>
    local _out="" _n="$2"
    while [ "$_n" -gt 0 ]; do _out="$_out$1"; _n=$((_n - 1)); done
    printf '%s' "$_out"
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

pad_to() { # pad_to <текст> <ширина> — подравняване по ЗНАЦИ (кирилицата е 2 байта!)
    local _s="$1" _w="$2" _n
    _n=$(( _w - ${#_s} ))
    [ "$_n" -lt 0 ] && _n=0
    printf '%s%s' "$_s" "$(repeat_char ' ' "$_n")"
}

# ------------------------- Мета: категории и тагове --------------------------
# Метаданните са коментар-ред ТОЧНО НАД реда на алиаса (безопасен при source):
#   # @aliashub tags=net,ssh category=server
#   alias srv='ssh root@srv'
META_TAG="# @aliashub "

CONFIG_DIR="$HOME/.config/aliashub"
CONFIG_FILE="$CONFIG_DIR/config"
# Миграция от aliasctl v3.x: пренеси старата конфиг папка (в нея са backup-ите)
if [ -d "$HOME/.config/aliasctl" ]; then
    if [ ! -d "$CONFIG_DIR" ]; then
        mv "$HOME/.config/aliasctl" "$CONFIG_DIR" 2>/dev/null || true
    elif [ -d "$HOME/.config/aliasctl/backups" ]; then
        # и двете папки съществуват — пренеси backup-ите без презапис
        mkdir -p "$CONFIG_DIR/backups" 2>/dev/null
        for _f in "$HOME/.config/aliasctl/backups"/aliases-*.bak; do
            [ -e "$_f" ] || continue
            _b="$CONFIG_DIR/backups/$(basename "$_f")"
            [ -e "$_b" ] || mv "$_f" "$_b" 2>/dev/null
        done
        rmdir "$HOME/.config/aliasctl/backups" 2>/dev/null
        rmdir "$HOME/.config/aliasctl" 2>/dev/null || true
        unset _f _b
    fi
fi

# Език: ALIASHUB_LANG > ALIASCTL_LANG (остаряла) > конфиг файл > LC_ALL/LC_MESSAGES/LANG > bg
_detect_lang() {
    local _l="${ALIASHUB_LANG:-${ALIASCTL_LANG:-}}"
    if [ -z "$_l" ] && [ -f "$CONFIG_FILE" ]; then
        _l="$(sed -n 's/^[[:space:]]*lang[[:space:]]*=[[:space:]]*//p' "$CONFIG_FILE" 2>/dev/null | head -n 1)"
        _l="$(lower "$(printf '%s' "$_l" | tr -d '[:space:]')")"
    fi
    if [ -z "$_l" ]; then
        _l="${LC_ALL:-${LC_MESSAGES:-${LANG:-bg}}}"
    fi
    case "$(lower "$_l")" in
        bg*) LANG_MODE="bg" ;;
        en*) LANG_MODE="en" ;;
        *)   LANG_MODE="bg" ;;
    esac
}
_detect_lang

# ------------------------- Работа с файла с алиаси --------------------------
ensure_file() {
    [ -f "$ALIASES_FILE" ] || { mkdir -p "$(dirname "$ALIASES_FILE")" 2>/dev/null; : > "$ALIASES_FILE"; }
}
ensure_backup_dir() { mkdir -p "$BACKUP_DIR" 2>/dev/null; }

alias_lines() { grep '^alias ' "$ALIASES_FILE" 2>/dev/null || true; }
alias_names() { alias_lines | sed 's/^alias //; s/=.*//'; }

count_aliases() {
    # ВНИМАНИЕ: без '|| echo 0' — grep -c извежда "0" и връща статус 1;
    # старият код дублираше числото и чупеше сравнението.
    local _n
    _n=$(grep -c '^alias ' "$ALIASES_FILE" 2>/dev/null || true)
    _n="${_n%%$'\n'*}"
    [ -z "$_n" ] && _n=0
    printf '%s' "$_n"
}

# Точно съвпадение по префикс "alias <име>=" — без regex, без инжекции.
# ВАЖНО: VAR=val awk ... (префикс-присвояване) -> стойността влиза в ENVIRON
# без обработка на escape последователности (за разлика от -v).
awk_get_line() { # <име> -> редът или нищо
    [ -f "$ALIASES_FILE" ] || return 0
    A_PREFIX="alias $1=" awk 'index($0, ENVIRON["A_PREFIX"]) == 1 { print; exit }' \
        "$ALIASES_FILE" 2>/dev/null
}

awk_remove_alias() { # <име> — изтрива точно реда на този алиас + метареда над него
    local _tmp _aln _mln=0 _prev
    _aln="$(A_PREFIX="alias $1=" awk 'index($0, ENVIRON["A_PREFIX"]) == 1 { print NR; exit }' \
        "$ALIASES_FILE" 2>/dev/null)"
    [ -n "$_aln" ] || return 0
    if [ "$_aln" -gt 1 ]; then
        _prev="$(sed -n "$((_aln - 1))p" "$ALIASES_FILE" 2>/dev/null)"
        case "$_prev" in
            "$META_TAG"*) _mln=$((_aln - 1)) ;;
        esac
    fi
    _tmp="$(mktemp)" || return 1
    A_MLN="$_mln" A_ALN="$_aln" awk '
        NR == ENVIRON["A_MLN"] { next }
        NR == ENVIRON["A_ALN"] { next }
        { print }
    ' "$ALIASES_FILE" > "$_tmp" || { rm -f "$_tmp"; return 1; }
    mv "$_tmp" "$ALIASES_FILE"
}

awk_replace_line() { # <стар_ред> <нов_ред> — точно заместване на цял ред
    local _tmp
    _tmp="$(mktemp)" || return 1
    A_OLD="$1" A_NEW="$2" awk \
        '$0 == ENVIRON["A_OLD"] { print ENVIRON["A_NEW"]; next } { print }' \
        "$ALIASES_FILE" > "$_tmp" || { rm -f "$_tmp"; return 1; }
    mv "$_tmp" "$ALIASES_FILE"
}

awk_replace_prefix() { # <старо_име> <ново_име> — преименуване, пази стойността
    local _tmp
    _tmp="$(mktemp)" || return 1
    A_OLDP="alias $1=" A_NEW="$2" awk '
        index($0, ENVIRON["A_OLDP"]) == 1 {
            print "alias " ENVIRON["A_NEW"] "=" substr($0, length(ENVIRON["A_OLDP"]) + 1)
            next
        }
        { print }
    ' "$ALIASES_FILE" > "$_tmp" || { rm -f "$_tmp"; return 1; }
    mv "$_tmp" "$ALIASES_FILE"
}

# ------------------------- Кавички (Bash + Zsh safe) ------------------------
sq() { # sq <текст> -> безопасно цитиран в единични кавички
    local _s="$1"
    _s="${_s//\'/\'\\\'\'}"
    printf "'%s'" "$_s"
}

unquote() { # обратна операция — само за показване
    local _v="$1"
    case "$_v" in
        "'"*"'")
            _v="${_v#\'}"
            _v="${_v%\'}"
            _v="${_v//\'\\\'\'/\'}"
            ;;
    esac
    printf '%s' "$_v"
}

# ------------------------- Валидация ----------------------------------------
is_valid_name() {
    # Правило на Bash за имена на алиаси: позволена е почти всяка буква —
    # ВКЛЮЧИТЕЛНО кирилица (alias списък=...) и точки (alias ..='cd ..').
    # Забраняваме само знаците, които чупят реда или разкриването:
    # интервали, кавички, $, `, =, &, ;, /, ( ), { }, [ ], |, *, ?, !, #, \\, <, >
    # и тире в началото (обърква се с опция на builtin 'alias').
    local _n="$1" _i _ch _len
    [ -n "$_n" ] || return 1
    case "${_n%"${_n#?}"}" in
        -) return 1 ;;
    esac
    _len=${#_n}
    for (( _i = 0; _i < _len; _i++ )); do
        _ch="${_n:_i:1}"
        case "$_ch" in
            [[:space:]]|\'|\"|\$|\`|\=|\&|\;|/|\(|\)|\{|\}|\[|\]|\||\*|\?|\!|\#|\\|\<|\>) return 1 ;;
        esac
    done
    return 0
}

name_conflict() { # заето ли е от команда/вградена команда
    command -v "$1" >/dev/null 2>&1
}

find_same_cmd() { # връща име на алиас със същата команда (или нищо)
    alias_lines | while IFS= read -r _line; do
        _n="${_line#alias }"; _v="${_line#*=}"
        _n="${_n%%=*}"
        if [ "$(unquote "$_v")" = "$1" ]; then printf '%s' "$_n"; return 0; fi
    done
    return 0
}

# ------------------------- Backup система -----------------------------------
prune_backups() {
    [ -d "$BACKUP_DIR" ] || return 0
    ls -1t "$BACKUP_DIR"/aliases-*.bak 2>/dev/null \
        | tail -n +$((MAX_BACKUPS + 1)) \
        | while IFS= read -r _old; do rm -f -- "$_old"; done
    return 0
}

make_backup() { # извежда пътя до новия backup (или нищо, ако няма файл)
    [ -f "$ALIASES_FILE" ] || return 0
    ensure_backup_dir
    local _f _stamp _c=1
    _stamp="$(date +%Y%m%d-%H%M%S 2>/dev/null || date +%s)"
    _f="$BACKUP_DIR/aliases-$_stamp.bak"
    # втори backup в същата секунда -> уникален суфикс (без презапис!)
    if [ -e "$_f" ]; then
        while [ -e "$BACKUP_DIR/aliases-$_stamp-$_c.bak" ]; do _c=$((_c + 1)); done
        _f="$BACKUP_DIR/aliases-$_stamp-$_c.bak"
    fi
    cp -p "$ALIASES_FILE" "$_f" 2>/dev/null || return 1
    prune_backups
    printf '%s' "$_f"
}

list_backups() { ls -1t "$BACKUP_DIR"/aliases-*.bak 2>/dev/null || true; }

# ------------------------- Интеракция ---------------------------------------
pause() {
    printf "%b%s%b" "${C_DIM}" "$(T gen.continue)" "${C_RESET}"
    read -r _ || true
    printf '\n'
}

confirm() { # confirm <ключ> [аргументи...] -> 0 = да
    local _ans
    printf "%b%s %b" "${C_WARNING}" "$(T "$@")" "${C_RESET}"
    read -r _ans || return 1
    case "$_ans" in
        д|Д|y|Y|да|Да|YES|Yes|yes) return 0 ;;
        *) return 1 ;;
    esac
}

pick_editor() {
    local _c
    for _c in "${VISUAL:-}" "${EDITOR:-}" nano vim vi; do
        [ -n "$_c" ] || continue
        if command -v "$_c" >/dev/null 2>&1; then EDITOR_CMD="$_c"; return 0; fi
    done
    EDITOR_CMD="vi"
}
