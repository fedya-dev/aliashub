        "$C_VAL" "$C_RESET" "$C_VAL" "$C_RESET" "$C_VAL" "$C_RESET"
    info "$(T hp.site)"
    printf "  %b%s%b\n\n" "$C_VAL$C_BOLD" "$ALIASHUB_SITE" "$C_RESET"
    pause
}

goodbye() {
    clear_screen
    printf '\n%b%s%b\n\n' "$C_SUCCESS$C_BOLD" "$(T gb.bye)" "$C_RESET"
    exit 0
}

# ------------------------------ главно меню ---------------------------------
main_menu() {
    print_header
    screen_title "$(T menu.prompt)"
    printf '\n'
    menu_row 1 "📋 $(T menu.m1)"
    menu_row 2 "➕ $(T menu.m2)"
    menu_row 3 "🔍 $(T menu.m3)"
    menu_row 4 "✏️  $(T menu.m4)"
    menu_row 5 "🗑️  $(T menu.m5)"
    menu_row 6 "📝 $(T menu.m6)"
    menu_row 7 "💾 $(T menu.m7)"
    menu_row 8 "🩺 $(T menu.m8)"
    menu_row 9 "📖 $(T menu.m9)"
    menu_row 10 "🏷️  $(T menu.m10)"
    menu_row 11 "🌐 $(T menu.m11)"
    printf '\n'
    printf "  %b[q]%b 🚪 %s\n\n" "$C_ERROR$C_BOLD" "$C_RESET" "$(T menu.quit)"
    printf "  %b➤%b " "$C_PRIMARY$C_BOLD" "$C_RESET"
    read -r _choice || { printf '\n'; exit 0; }
    case "$_choice" in
        1) list_screen ;;
        2) add_screen ;;
        3) search_screen ;;
        4) edit_screen ;;
        5) remove_screen ;;
        6) file_screen ;;
        7) backup_screen ;;
        8) check_screen ;;
        9) help_screen ;;
        10) tags_screen ;;
        11) lang_screen ;;
        q|Q) goodbye ;;
        *) fail "$(T err.invalid_choice)"; sleep 1 ;;
    esac
}

run_menu() {
    ALIASHUB_INTERACTIVE=1
    pick_editor
    if [ -t 1 ]; then printf '\033]2;ALIASHUB\007'; fi
    while true; do
        main_menu
    done
}
